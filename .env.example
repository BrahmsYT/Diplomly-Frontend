# Backend portu - backend/.env faylindaki PORT deyeri ile eyni olmalidir.
# Vite dev serveri /api sorgularini bu porta yonlendirir.
BACKEND_PORT=4001

# Production build-de proxy islemir; API-nin tam unvani burada verilir.
# Development-de bos saxlayin.
# VITE_API_URL=https://api.diplomly.com

# Yalniz backend-de TEST_SEED_SECRET teyin edilibse lazımdır (CRIT-01
# qorunmasi). Eyni deyer olmalidir - eks halda /test sehifesi 403 alar.
# VITE_TEST_SEED_SECRET=
